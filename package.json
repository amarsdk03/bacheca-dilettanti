{
  "name": "bacheca-dilettanti",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:browser:admin": "node scripts/dashboard-browser/run.mjs",
    "test:browser:admin:production": "node scripts/dashboard-browser/run.mjs --production",
    "test:browser:admin:session": "node scripts/dashboard-browser/run.mjs --session",
    "test:browser:admin:home": "node scripts/dashboard-browser/run.mjs --home",
    "test:browser:admin:annunci": "node scripts/dashboard-browser/run.mjs --annunci",
    "test:browser:admin:registro": "node scripts/dashboard-browser/run.mjs --registro",
    "dev": "npm run dev --workspace=bacheca-dilettanti-webapp",
    "build": "npm run build --workspace=bacheca-dilettanti-webapp",
    "start": "npm run start --workspace=bacheca-dilettanti-webapp",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=bacheca-dilettanti-webapp",
    "dev:admin": "npm run dev --workspace=bacheca-dilettanti-admin",
    "build:admin": "npm run build --workspace=bacheca-dilettanti-admin",
    "start:admin": "npm run start --workspace=bacheca-dilettanti-admin",
    "typecheck:admin": "npm run typecheck --workspace=bacheca-dilettanti-admin",
    "check:test-target:admin": "node --env-file=apps/admin/.env.local scripts/assert-test-target.mjs",
    "dashboard:local:prepare": "node scripts/dashboard-local/run.mjs prepare",
    "dashboard:local:check": "node scripts/dashboard-local/run.mjs check",
    "dashboard:local:start": "node scripts/dashboard-local/run.mjs start",
    "dashboard:local:stop": "node scripts/dashboard-local/run.mjs stop",
    "dashboard:local:export": "node scripts/dashboard-local/run.mjs export-schema",
    "dashboard:local:inspect": "node scripts/dashboard-local/run.mjs inspect-schema"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
