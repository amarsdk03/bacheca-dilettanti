# Read ONLY by export-schema. Copy to .local/dashboard-supabase/source.env.
# Supabase Dashboard > Connect > Direct connection or Session pooler (5432).
# Do not use the transaction pooler (6543), API keys, or a connection URI.
BACHECA_SCHEMA_SOURCE_PROJECT_REF=
BACHECA_SCHEMA_SOURCE_HOST=
BACHECA_SCHEMA_SOURCE_ALLOWED_HOST=
BACHECA_SCHEMA_SOURCE_PORT=5432
BACHECA_SCHEMA_SOURCE_DATABASE=postgres
# Direct: postgres. Session pooler: postgres.<project-ref>.
BACHECA_SCHEMA_SOURCE_USER=
# Quote passwords containing #, spaces, or quotes following dotenv syntax.
BACHECA_SCHEMA_SOURCE_PASSWORD=
