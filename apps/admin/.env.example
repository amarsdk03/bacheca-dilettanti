# Placeholder only. The static scaffold works without an .env.local file.
# Set URL and publishable key for the same LOCAL/STAGING project as apps/web.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend audit transport only. Never prefix with NEXT_PUBLIC_ or copy to clients.
# Same LOCAL/STAGING project as the session client; not required by the scaffold.
SUPABASE_SECRET_KEY=

# Required before database tests or seeds. Never add production to this list.
BACHECA_TEST_TARGET=local
BACHECA_TEST_ALLOWED_SUPABASE_ORIGINS=http://127.0.0.1:54321
